# Скопируйте этот файл в .env и заполните значения.
# Файл .env никому не передавайте и никуда не выкладывайте.

# Порт, на котором работает сервер
PORT=3000

# Папка для базы заявок и фото (на сервере Amvera: /data)
DATA_DIR=./data

# Общий пароль менеджера для входа в кабинет
ADMIN_PASSWORD=

# Telegram (Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX (MAX Bot API)
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# WhatsApp через шлюз Green-API
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
WHATSAPP_CHAT_ID=

# Доверять ли заголовку X-Forwarded-For (на Amvera true, на компьютере false)
TRUST_PROXY=false
