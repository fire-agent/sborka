{
  "name": "pwa-master-apps",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Лёгкое PWA для сбора заявок мастерам по ремонту мебели и окон",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "check:db": "node scripts/check-db.js",
    "check:requests": "node scripts/check-requests.js",
    "check:logo": "node scripts/check-logo.js",
    "demo:windows": "copy /Y public\\configs\\windows.json public\\config.json",
    "demo:furniture": "copy /Y public\\configs\\furniture.json public\\config.json",
    "demo:cleaning": "copy /Y public\\configs\\cleaning.json public\\config.json"
  }
}
